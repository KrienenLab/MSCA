### ============================================================================ ###
###                                  Load data                                   ###
### ============================================================================ ###
mouse <- read.csv(file.path(data_dir, "homology_clusters_mouse_all.csv"), row.names = 1)
## Fig. 2C: expressolog scores between human, marmoset and mouse, computed within each Siletti supercluster.
## Expressolog score from https://github.com/gillislab/Primate-MTG-coexpression/tree/main/scripts
## Run from the Cross_Species_Comparison folder.
##
## Inputs (in ./data):
##   homology_clusters_{mouse,marmoset,human}_all.csv  homology-cluster metacells for the 114 clusters shared by
##                                                     the three species (rows, same order) x highly variable genes
##   Neurons_cluster_table.csv                         Siletti cluster table (cluster_id, supercluster_term)
library(dplyr)
library(ggplot2)
data_dir <- "data"
out_dir  <- "output"
dir.create(out_dir, showWarnings = FALSE)
### ============================================================================ ###
###                                Functions                                     ###
### ============================================================================ ###
## bidirectional specificity score of a correlation matrix (genes x genes)
calc_spec <- function(res, np, nL) {
ranks <- 1:nL
mini  <- sum(ranks[1:np])
range <- np * (nL - np)
temp1 <- t(apply(res, 1, function(x) rank(x, na.last = "keep", ties.method = "average")))
spec1 <- (temp1 - mini) / range
temp2 <- t(apply(t(res), 1, function(x) rank(x, na.last = "keep", ties.method = "average")))
spec2 <- (temp2 - mini) / range
specna <- (!is.na(spec1)) + (!is.na(spec2))
spec1 <- as.data.frame(spec1)
spec2 <- as.data.frame(spec2)
spec1[is.na(spec1)] <- 0
spec2[is.na(spec2)] <- 0
(spec1 + spec2) / specna
}
## per-gene expressolog score between two metacell matrices (rows = clusters, columns = genes)
do_expressolog <- function(mat1, mat2) {
## filter lowly expressed genes, then keep genes present in both matrices
mat1 <- mat1[, colSums(mat1) > 0.5]
mat2 <- mat2[, colSums(mat2) > 0.5]
genes <- intersect(colnames(mat1), colnames(mat2))
allcorr <- cor(mat1[, genes], mat2[, genes], method = "pearson")
diag(as.matrix(calc_spec(allcorr, 1, nrow(allcorr))))
}
### ============================================================================ ###
###                                  Load data                                   ###
### ============================================================================ ###
mouse <- read.csv(file.path(data_dir, "homology_clusters_mouse_all.csv"), row.names = 1)
marm  <- read.csv(file.path(data_dir, "homology_clusters_marmoset_all.csv"), row.names = 1)
human <- read.csv(file.path(data_dir, "homology_clusters_human_all.csv"), row.names = 1)
stopifnot(identical(rownames(mouse), rownames(marm)), identical(rownames(mouse), rownames(human)))
## Siletti cluster -> supercluster
siletti_annot <- read.csv(file.path(data_dir, "Neurons_cluster_table.csv"))
siletti_annot$cluster_id <- paste0("siletti_", siletti_annot$cluster_id)
### ============================================================================ ###
###              Expressolog score within each Siletti supercluster              ###
### ============================================================================ ###
HVG_supercluster_res <- list()
for (each_sc in setdiff(unique(siletti_annot$supercluster_term), "Cerebellar inhibitory")) {
sc_clusters <- siletti_annot$cluster_id[siletti_annot$supercluster_term == each_sc]
sc_mouse <- mouse[rownames(mouse) %in% sc_clusters, ]
sc_marm  <- marm[rownames(marm) %in% sc_clusters, ]
sc_human <- human[rownames(human) %in% sc_clusters, ]
if (min(nrow(sc_mouse), nrow(sc_marm), nrow(sc_human)) < 2) {
message("Skipping ", each_sc, " due to insufficient clusters")
next
}
HVG_supercluster_res[[each_sc]] <- rbind(
data.frame(score = do_expressolog(sc_mouse, sc_marm),  comp = "mouse_marm"),
data.frame(score = do_expressolog(sc_mouse, sc_human), comp = "mouse_human"),
data.frame(score = do_expressolog(sc_marm, sc_human),  comp = "marm_human"))
}
## mean expressolog score per supercluster and species comparison
supercluster_scores <- bind_rows(HVG_supercluster_res, .id = "supercluster") %>%
group_by(supercluster, comp) %>%
summarise(mean_expressolog_score = mean(score), .groups = "drop") %>%
group_by(supercluster) %>%
filter(!anyNA(mean_expressolog_score)) %>%  # drop superclusters with NA scores
ungroup() %>%
mutate(supercluster = factor(supercluster, levels = names(HVG_supercluster_res)),
comp = factor(comp, levels = c("marm_human", "mouse_marm", "mouse_human")))
### ============================================================================ ###
###                                  Line plot                                   ###
### ============================================================================ ###
p <- ggplot(supercluster_scores,
aes(x = supercluster, y = mean_expressolog_score, group = comp, color = comp)) +
geom_line() +
geom_point() +
labs(x = "Siletti Supercluster", y = "Mean\nExpressolog\nScore") +
scale_color_manual(labels = c("Marmoset-Human", "Mouse-Marmoset", "Mouse-Human"),
values = c("#7BAF7B", "#914E5E", "#5B7FA1"), name = "Species Comparison") +
theme_classic() +
theme(axis.text.x = element_text(angle = 90, hjust = 1)) +
ylim(0.5, 0.95)
ggsave(file.path(out_dir, "HVG_supercluster_expressolog_scores.svg"), p, width = 6, height = 3)
## x-axis order of the superclusters
supercluster_order <- c("Splatter", "Thalamic excitatory", "Amygdala excitatory", "Medium spiny neuron",
"Miscellaneous", "CGE interneuron", "Deep-layer corticothalamic and 6b",
"Deep-layer intratelencephalic", "Hippocampal CA4", "MGE interneuron",
"Hippocampal CA1-3", "Eccentric medium spiny neuron")
stopifnot(setequal(names(HVG_supercluster_res), supercluster_order))
## mean expressolog score per supercluster and species comparison
supercluster_scores <- bind_rows(HVG_supercluster_res, .id = "supercluster") %>%
group_by(supercluster, comp) %>%
summarise(mean_expressolog_score = mean(score), .groups = "drop") %>%
group_by(supercluster) %>%
filter(!anyNA(mean_expressolog_score)) %>%  # drop superclusters with NA scores
ungroup() %>%
mutate(supercluster = factor(supercluster, levels = supercluster_order),
comp = factor(comp, levels = c("marm_human", "mouse_marm", "mouse_human")))
### ============================================================================ ###
###                                  Line plot                                   ###
### ============================================================================ ###
p <- ggplot(supercluster_scores,
aes(x = supercluster, y = mean_expressolog_score, group = comp, color = comp)) +
geom_line() +
geom_point() +
labs(x = "Siletti Supercluster", y = "Mean\nExpressolog\nScore") +
scale_color_manual(labels = c("Marmoset-Human", "Mouse-Marmoset", "Mouse-Human"),
values = c("#7BAF7B", "#914E5E", "#5B7FA1"), name = "Species Comparison") +
theme_classic() +
theme(axis.text.x = element_text(angle = 90, hjust = 1)) +
ylim(0.5, 0.95)
ggsave(file.path(out_dir, "HVG_supercluster_expressolog_scores.svg"), p, width = 6, height = 3)
